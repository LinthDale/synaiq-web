---
import Figure from '../Figure.astro';
import Section from '../Section.astro';
import type { BlockProps } from './types.ts';

type Props = BlockProps<'screenshots'>;
const { block } = Astro.props;
---

<Section id={block.id} eyebrow={block.eyebrow} title={block.title} description={block.description}>
  <div class="screenshot-grid">
    {block.items.map((item) => <Figure src={item.src} alt={item.alt} caption={item.caption} />)}
  </div>
</Section>

<style>
  .screenshot-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
</style>
