---
import ItemList from '../ItemList.astro';
import Section from '../Section.astro';
import type { BlockProps } from './types.ts';

type Props = BlockProps<'services'>;
const { block } = Astro.props;
---

<Section id={block.id} eyebrow={block.eyebrow} title={block.title} description={block.description}>
  <ItemList items={block.items} />

  {
    block.documents.length > 0 && (
      <ul class="document-list">
        {block.documents.map((doc) => (
          <li data-kind={doc.kind}>{doc.label}</li>
        ))}
      </ul>
    )
  }

  {block.target && <p class="services-target">{block.target}</p>}
</Section>

<style>
  .document-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .document-list li {
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .services-target {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }
</style>
