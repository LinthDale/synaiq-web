---
/**
 * Deployment options. The source content (agi.md) has no heading for this
 * block -- it was a tag row appended to the flow section -- so no heading is
 * invented and the section stays an unnamed generic region.
 */
import ItemList from '../ItemList.astro';
import Section from '../Section.astro';
import type { BlockProps } from './types.ts';

type Props = BlockProps<'deployment'>;
const { block } = Astro.props;
---

<Section id={block.id} eyebrow={block.eyebrow} title={block.title} description={block.description}>
  <ItemList items={block.items} />
</Section>
