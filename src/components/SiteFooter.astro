---
/** 全站頁尾：公司名與版權宣告，兩者都來自 `site` collection。 */
import type { SiteData } from '../lib/content.ts';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <p class="site-footer-company">{site.footer.company}</p>
    <p class="site-footer-copyright"><small>{site.footer.copyright}</small></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-16);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--color-border-subtle);
    color: var(--color-text-muted);
  }

  .site-footer-company {
    margin-block-end: var(--space-1);
  }

  .site-footer-copyright {
    margin: 0;
  }
</style>
