{
  "name": "synaiq-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:pvsim-viewer": "node scripts/build-pvsim-viewer-vendor.mjs",
    "dev": "astro dev",
    "dev:design": "node docs/design/live-prototype/share-preview.mjs",
    "predev:design": "npm run i18n:sync",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "migrate:content": "node scripts/migrate-content.mjs",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:design": "npm run check:locales && node --import ./docs/design/live-prototype/test-i18n-setup.mjs --test docs/design/live-prototype/*.test.mjs",
    "test:deploy": "npm run check:locales && node --import ./docs/design/live-prototype/test-i18n-setup.mjs --test scripts/hostinger/*.test.mjs",
    "test:all": "npm test && npm run test:design",
    "test:design:visual": "node scripts/check-design-visual.mjs",
    "test:pvsim-viewer": "node scripts/check-pvsim-viewer.mjs",
    "i18n:sync": "node docs/design/live-prototype/scripts/sync-locales.mjs",
    "i18n:add": "node docs/design/live-prototype/scripts/add-locale.mjs",
    "build:locales": "npm run i18n:sync",
    "check:locales": "node docs/design/live-prototype/scripts/sync-locales.mjs --check",
    "test:i18n:browser": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  }
}
